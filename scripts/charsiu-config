#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
#
# charsiu-config -- a front end to /etc/charsiu/config.ini and the charsiu tools.
#
# ⚠ NO CURSES. kiln's equivalent is a whiptail TUI because kiln runs on Armbian,
# which has one. charsiu's rootfs is a minimal buildroot with no whiptail, no
# dialog, no newt and no slang, and the board is normally driven over a
# 1.5 Mbaud serial console where a full-screen redraw is worse than a numbered
# menu anyway. So the menu is plain text and depends on nothing. If whiptail IS
# present (running this on a real distro) it is used instead.
#
# config.ini stays the hand-editable source of truth: every write goes through
# an in-place editor that preserves comments and keys this script never heard of.
set -u

CONF="${CHARSIU_CONFIG:-/etc/charsiu/config.ini}"
MODELS_DIR="${CHARSIU_MODELS_DIR:-/opt/charsiu/models}"
for t in ${CHARSIU_LIB:+"$CHARSIU_LIB/charsiu-tui.sh"} \
	 "$(dirname "$0")/charsiu-tui.sh" \
	 "$(dirname "$0")/../scripts/charsiu-tui.sh" \
	 "$(dirname "$0")/../opt/charsiu/charsiu-tui.sh" \
	 /opt/charsiu/charsiu-tui.sh; do
	[ -r "$t" ] && { . "$t"; break; }
done
command -v ui_menu >/dev/null 2>&1 || { echo "charsiu-tui.sh not found" >&2; exit 1; }
CTUI_TITLE="charsiu"

here=$(dirname "$0")
tool() {
	for c in "$here/$1" "$here/../build/$1" "/opt/charsiu/$1"; do
		[ -x "$c" ] && { echo "$c"; return; }
	done
	command -v "$1" 2>/dev/null || true
}

if [ -t 1 ]; then
	C_B=$(printf '\033[1m'); C_G=$(printf '\033[1;32m')
	C_Y=$(printf '\033[1;33m'); C_D=$(printf '\033[2m'); C_0=$(printf '\033[0m')
else C_B=; C_G=; C_Y=; C_D=; C_0=; fi

# ---------------------------------------------------------------------------
# INI: read, and write IN PLACE. Present -> replace where it is. Absent -> append
# to the END OF ITS OWN SECTION, creating the section if there is none.
#
# ⚠ A naive `sed -i "s/^key =.*/key = $v/"` silently does NOTHING when the key
# is missing, and corrupts the file when the value contains / or &. The value is
# passed to awk as a VARIABLE, never interpolated into a pattern.
# ---------------------------------------------------------------------------
ini_get() {
	[ -f "$CONF" ] || return 0
	awk -v s="$1" -v k="$2" '
		/^[ \t]*\[.*\][ \t]*$/ { h=$0; sub(/^[ \t]*\[/,"",h); sub(/\][ \t]*$/,"",h); t=(h==s); next }
		t { if (match($0,/^[ \t]*[^=]*=/)) { n=substr($0,1,RLENGTH-1); gsub(/^[ \t]+|[ \t]+$/,"",n);
		    if (n==k) { v=substr($0,RLENGTH+1); sub(/[ \t]#.*$/,"",v); gsub(/^[ \t]+|[ \t]+$/,"",v); print v; exit } } }
	' "$CONF"
}

ini_set() {
	sec=$1; key=$2; val=$3
	[ -f "$CONF" ] || { mkdir -p "$(dirname "$CONF")" && : > "$CONF"; }
	t="${CONF}.tmp.$$"
	awk -v s="$sec" -v k="$key" -v v="$val" '
	function flush_pending() {
		if (in_sec && !done) { print k " = " v; done = 1 }
	}
	/^[ \t]*\[.*\][ \t]*$/ {
		# leaving a section: if it was ours and the key never appeared,
		# append it at the end of that section rather than the file.
		flush_pending()
		h = $0; sub(/^[ \t]*\[/,"",h); sub(/\][ \t]*$/,"",h)
		in_sec = (h == s); if (in_sec) seen_sec = 1
		print; next
	}
	{
		if (in_sec && !done && match($0, /^[ \t]*[^=]*=/)) {
			n = substr($0, 1, RLENGTH-1); gsub(/^[ \t]+|[ \t]+$/,"",n)
			if (n == k) { print k " = " v; done = 1; next }
		}
		print
	}
	END {
		flush_pending()
		if (!seen_sec) { print ""; print "[" s "]"; print k " = " v }
	}' "$CONF" > "$t" && mv "$t" "$CONF"
}

# ⚠ A cancelled ui_input must not silently write an empty value into the
# config. ask keeps the old value when the user backs out.
ask() {   # ask PROMPT DEFAULT -> the answer, or DEFAULT if cancelled
	v=$(ui_input "$1" "$2") || v="$2"
	[ -n "$v" ] && echo "$v" || echo "$2"
}

pause() { [ "$CTUI" = whiptail ] || { printf '\n%spress enter%s ' "$C_D" "$C_0"; read -r _ || true; }; }

# ---------------------------------------------------------------------------
page_status() {
	D=$(tool charsiu-doctor)
	if [ -n "$D" ]; then CHARSIU_CONFIG="$CONF" "$D" || true
	else echo "  charsiu-doctor not found"; fi
	pause
}

page_model() {
	while :; do
		cur=$(ini_get model path)
		set --
		for f in "$MODELS_DIR"/*.gguf; do
			[ -f "$f" ] || continue
			mb=$(( $(stat -c%s "$f" 2>/dev/null || echo 0) / 1048576 ))
			mark=""; [ "$f" = "$cur" ] && mark="  <- in use"
			set -- "$@" "$(basename "$f")" "${mb}M$mark"
		done
		set -- "$@" "[get]" "download one" "[check]" "gate a file by hand" "[back]" ""
		sel=$(ui_menu "Model
now: ${cur:-(unset)}" "$@") || return
		case "$sel" in
		"[back]"|"") return ;;
		"[get]")
			G=$(tool charsiu-get)
			[ -n "$G" ] && CHARSIU_MODELS_DIR="$MODELS_DIR" CHARSIU_LIB="${CHARSIU_LIB:-/opt/charsiu}" "$G" --wizard
			pause ;;
		"[check]")
			CK=$(tool charsiu_check)
			f=$(ask "file to check" "$cur")
			[ -n "$CK" ] && "$CK" "$f"; pause ;;
		*)
			sel="$MODELS_DIR/$sel"
			# ⚠ never point the config at a file the runtime cannot load
			CK=$(tool charsiu_check)
			if [ -n "$CK" ] && ! out=$("$CK" -q "$sel" 2>&1); then
				ui_msg "Not selected.

charsiu cannot run that file:
  $out"
				continue
			fi
			ini_set model path "$sel"
			ui_note "set: $(basename "$sel")" ;;
		esac
	done
}

page_run() {
	printf '\n%sRun%s\n' "$C_B" "$C_0"
	t=$(ask "threads" "$(ini_get run threads)");  ini_set run threads "$t"
	c=$(ask "context, in tokens" "$(ini_get run context)"); ini_set run context "$c"
	printf '  %sRK3576 is 4x A53 at 0-3 and 4x A72 at 4-7. Round 379 measured the\n' "$C_D"
	printf '  A53s at 11.17 tok/s against 14.59, with no energy saving. Keep 4-7.%s\n' "$C_0"
	p=$(ask "cpus" "$(ini_get run cpus)"); ini_set run cpus "$p"
	pause
}

page_npu() {
	printf '\n%sNPU%s\n' "$C_B" "$C_0"
	e=$(ask "use the NPU (yes/no)" "$(ini_get npu enable)"); ini_set npu enable "$e"
	printf '  %sone value, written to both CHARSIU_NPU_KMAX and CHARSIU_NPU_W4_GROUP;\n' "$C_D"
	printf '  npudev only takes the int4 path when the two are equal.%s\n' "$C_0"
	k=$(ask "K slice" "$(ini_get npu kslice)"); ini_set npu kslice "$k"
	m=$(ask "max N" "$(ini_get npu maxn)"); ini_set npu maxn "$m"
	f=$(ask "coefficient elements" "$(ini_get npu coef_elems)"); ini_set npu coef_elems "$f"
	pause
}

page_show() {
	L=$(tool charsiu)
	printf '\n%sThe command this config produces%s\n\n' "$C_B" "$C_0"
	[ -n "$L" ] && CHARSIU_CONFIG="$CONF" "$L" --show -p "The capital of France is" -n 64 \
		     || echo "  charsiu launcher not found"
	pause
}

# ---------------------------------------------------------------------------
# FIRST RUN. Not a separate program and not an init script: an init script would
# fight the round harness for the console on a test board, and a second program
# would drift from this one. `charsiu-config --setup` walks the same pages in
# the order a new board needs them.
# ---------------------------------------------------------------------------
setup_walk() {
	ui_msg "charsiu

An open runtime for the RK3576 NPU. Nothing here is the vendor's
stack: the kernel driver is mainline rocket and the userspace is
this.

A few questions, then it runs."

	D=$(tool charsiu-doctor)
	if [ -n "$D" ] && ! CHARSIU_CONFIG="$CONF" "$D" -q; then
		ui_yesno "Something critical is wrong (above).

Carry on with the setup anyway?" defaultno || return 1
	fi

	if [ -z "$(ls "$MODELS_DIR"/*.gguf 2>/dev/null || true)" ]; then
		G=$(tool charsiu-get)
		[ -n "$G" ] && CHARSIU_MODELS_DIR="$MODELS_DIR" \
			CHARSIU_LIB="${CHARSIU_LIB:-/opt/charsiu}" "$G" --wizard
	fi
	page_model
	t=$(ask "How many threads? RK3576 has four A72s and charsiu uses one thread's worth of work." "$(ini_get run threads)")
	ini_set run threads "$t"
	mkdir -p "$(dirname "$STAMP")" 2>/dev/null || true
	: > "$STAMP" 2>/dev/null || true
	ui_msg "Set up.

  charsiu -p \"...\"    ask it something
  charsiu-config     come back here
  charsiu-doctor     when something looks wrong"
	return 0
}

STAMP="${CHARSIU_STAMP:-$(dirname "$CONF")/.setup-done}"
case "${1:-}" in
--setup)      setup_walk; exit $? ;;
--setup-once) [ -e "$STAMP" ] && exit 0; setup_walk; exit $? ;;
esac

while :; do
	c=$(ui_menu "charsiu-config    $CONF" \
		status "what works and what does not" \
		model  "pick, fetch, or check one" \
		run    "threads, context, cores" \
		npu    "the switches that decide the fast path" \
		show   "the exact command this produces" \
		chat   "run it now" \
		quit   "") || exit 0
	case "$c" in
	status) page_status ;;
	model)  page_model ;;
	run)    page_run ;;
	npu)    page_npu ;;
	show)   page_show ;;
	chat)   L=$(tool charsiu); [ -n "$L" ] && CHARSIU_CONFIG="$CONF" "$L" --chat || true; pause ;;
	quit|"") exit 0 ;;
	esac
done
