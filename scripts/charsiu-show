#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# `charsiu show [MODEL]`
#
# ⚠ THE POINT OF THIS COMMAND IS THE VERDICT. A gguf's name lies in both
# directions, measured: ...-Q4_0_4_4.gguf is type 31 in 210 tensors, a Q4_0
# repacked for ARM dotprod that passes any name test, and ...-Q6_K_L.gguf is
# perfectly runnable although the suffix looks exotic. Only the contents decide,
# so this reads them with the runtime's own parser.
set -eu
MODELS="${CHARSIU_MODELS:-$HOME/.charsiu/models}"
SYS=/opt/charsiu/models
CONF="${CHARSIU_CONFIG:-$HOME/.charsiu/config.ini}"
[ -f "$CONF" ] || CONF=/etc/charsiu/config.ini
# ⚠ may still not exist; every reader below tolerates that.
here=$(dirname "$0")
find1() { for c in "$here/$1" "$here/../build/$1" "/opt/charsiu/$1"; do
	[ -x "$c" ] && { echo "$c"; return; }; done; command -v "$1" 2>/dev/null || true; }

M="${1:-}"
if [ -z "$M" ]; then
	M=$(awk '/^[ \t]*\[model\]/{f=1;next} /^[ \t]*\[/{f=0} f && /^[ \t]*path[ \t]*=/{
		sub(/^[^=]*=[ \t]*/,""); sub(/[ \t]#.*$/,""); print; exit}' "$CONF" 2>/dev/null || true)
	[ -n "$M" ] || { echo "charsiu show: no model set and none named" >&2; exit 2; }
fi
for c in "$M" "$MODELS/$M" "$SYS/$M" "$MODELS/$M.gguf" "$SYS/$M.gguf"; do
	[ -f "$c" ] && { M="$c"; break; }
done
[ -f "$M" ] || { echo "charsiu show: no such model: $M" >&2; exit 2; }

R=$(find1 charsiu_run); [ -n "$R" ] && "$R" "$M" --info 2>/dev/null
C=$(find1 charsiu_check)
if [ -n "$C" ]; then
	echo
	"$C" "$M"
	exit $?
fi
exit 0
