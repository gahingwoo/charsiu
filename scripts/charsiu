#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
#
# charsiu: the front door.
#
# ⚠ ONE RULE DECIDES WHO SEES WHAT, AND THERE IS NO FLAG FOR IT:
#
#     charsiu, nothing set up yet -> the guided screen
#     charsiu, already set up      -> a conversation
#     charsiu <anything else>      -> the command, and never a dialog
#
# Somebody who bought this board because it looked interesting types `charsiu`
# and is led through it. Somebody who lives in a terminal types `charsiu pull x`
# and never meets a dialog at all. Neither has to know the other mode exists.
#
# ⚠ THE CLI SHAPE IS NOT INVENTED HERE. It follows ollama, whose users already
# know `run / pull / list / ls / rm / show / ps / serve`, and claude code, where
# a bare command is interactive, a quoted argument is one-shot, and -p prints
# and accepts a pipe. Copying a convention people already have is most of what
# "easy to use" means.
set -eu

VERSION=0.1
SELF=$(basename "$0")
here=$(dirname "$0")

for t in ${CHARSIU_LIB:+"$CHARSIU_LIB/charsiu-tui.sh"} \
	 "$here/charsiu-tui.sh" "$here/../scripts/charsiu-tui.sh" \
	 "$here/../opt/charsiu/charsiu-tui.sh" /opt/charsiu/charsiu-tui.sh; do
	[ -r "$t" ] && { . "$t"; break; }
done
command -v ui_menu >/dev/null 2>&1 || { echo "$SELF: charsiu-tui.sh not found" >&2; exit 1; }
CTUI_TITLE="charsiu"

# ---------------------------------------------------------------------------
# WHERE THINGS LIVE
#
# ⚠ USER FIRST, SYSTEM AS A FALLBACK. The old layout put the config in
# /etc/charsiu and the models in /opt/charsiu/models, so a plain user could
# neither configure nor download without root. ollama, codex and claude code all
# keep per-user state under $HOME and so does this. The system paths are still
# read, because the board image ships models there.
# ---------------------------------------------------------------------------
CHARSIU_HOME="${CHARSIU_HOME:-$HOME/.charsiu}"
CONF="${CHARSIU_CONFIG:-$CHARSIU_HOME/config.ini}"
[ -f "$CONF" ] || [ ! -f /etc/charsiu/config.ini ] || CONF=/etc/charsiu/config.ini
MODELS="${CHARSIU_MODELS:-$CHARSIU_HOME/models}"
SYSMODELS=/opt/charsiu/models

libexec() {
	for d in ${CHARSIU_LIBEXEC:+"$CHARSIU_LIBEXEC"} "$here" "$here/../libexec" \
		 /opt/charsiu/libexec /opt/charsiu; do
		[ -x "$d/$1" ] && { echo "$d/$1"; return; }
	done
	command -v "$1" 2>/dev/null || true
}

# every gguf we can see, user directory first
all_models() {
	for d in "$MODELS" "$SYSMODELS"; do
		[ -d "$d" ] || continue
		for f in "$d"/*.gguf; do [ -f "$f" ] && echo "$f"; done
	done
}
have_model() { [ -n "$(all_models | head -1)" ]; }

ini_get() {
	[ -f "$CONF" ] || return 0
	awk -v s="$1" -v k="$2" '
		/^[ \t]*\[.*\][ \t]*$/ { h=$0; sub(/^[ \t]*\[/,"",h); sub(/\][ \t]*$/,"",h); t=(h==s); next }
		t { if (match($0,/^[ \t]*[^=]*=/)) { n=substr($0,1,RLENGTH-1); gsub(/^[ \t]+|[ \t]+$/,"",n);
		    if (n==k) { v=substr($0,RLENGTH+1); sub(/[ \t]#.*$/,"",v); gsub(/^[ \t]+|[ \t]+$/,"",v); print v; exit } } }
	' "$CONF"
}
configured() { m=$(ini_get model path); [ -n "$m" ] && [ -f "$m" ]; }

usage() {
cat <<USAGE
charsiu $VERSION, an open LLM runtime for the RK3576 NPU

  $SELF                       a conversation, or the guided setup on a new board
  $SELF "what is a bandgap"   ask once and exit
  $SELF -p "..."              print mode; reads a pipe:  cat f | $SELF -p "sum up"

  $SELF run MODEL [PROMPT]    use a particular model
  $SELF pull [NAME]           fetch one; no NAME opens the picker
  $SELF list                  what is here                        (alias: ls)
  $SELF rm NAME               delete one
  $SELF show [MODEL]          what it is, and whether it can run here
  $SELF ps                    is anything running
  $SELF bench                 tokens per second on this board
  $SELF doctor [--paste]      what works and what does not
  $SELF serve [--port N]      an OpenAI and Anthropic compatible endpoint
  $SELF setup                 the guided screen, on purpose

  models  $MODELS  (and $SYSMODELS)
  config  $CONF
USAGE
}

case "${1:-}" in
-h|--help|help)  usage; exit 0 ;;
-V|--version)    echo "charsiu $VERSION"; exit 0 ;;
setup)           exec "$(libexec charsiu-config)" --setup ;;
doctor)          shift; exec "$(libexec charsiu-doctor)" "$@" ;;
pull)            shift
                 # ⚠ ${1:+"$@"} ${1:-x} repeats the first argument. Set the
                 # default by replacing the list instead.
                 [ $# -gt 0 ] || set -- --wizard
                 exec env CHARSIU_MODELS_DIR="$MODELS" "$(libexec charsiu-get)" "$@" ;;
list|ls)         shift; exec "$(libexec charsiu-list)" "$@" ;;
rm)              shift; exec "$(libexec charsiu-rm)" "$@" ;;
show)            shift; exec "$(libexec charsiu-show)" "$@" ;;
ps)              shift; exec "$(libexec charsiu-ps)" "$@" ;;
bench)           shift; exec "$(libexec charsiu-runner)" bench "$@" ;;
serve)           shift; exec "$(libexec charsiu-serve)" "$@" ;;
run)             shift
                 [ $# -ge 1 ] || { echo "$SELF run: which model?" >&2; exit 2; }
                 M="$1"; shift
                 exec env CHARSIU_MODEL="$M" "$(libexec charsiu-runner)" "$@" ;;
esac

# ---------------------------------------------------------------------------
# No subcommand. Decide between the guided screen and a conversation.
# ---------------------------------------------------------------------------
if [ $# -eq 0 ] && { ! configured || ! have_model; }; then
	# ⚠ Not an error and not a lecture. A board with nothing on it should walk
	# somebody through it, once, and never mention it again.
	exec "$(libexec charsiu-config)" --setup
fi

exec "$(libexec charsiu-runner)" "$@"
